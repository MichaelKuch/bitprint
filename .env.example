# All optional. These are read by vite.config.ts only (not exposed to client code).

# Dev server
HOST=0.0.0.0
PORT=3000
# Set to "none" to stop the browser opening on `npm start`
BROWSER=none

# Public base path when served from a subpath (e.g. /bitprint). Leave empty for "/"
PUBLIC_URL=

# Build output directory and sourcemaps
BUILD_PATH=dist
GENERATE_SOURCEMAP=false
