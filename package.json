{
  "name": "bitprint",
  "description": "Print your Bitwarden vault.",
  "version": "2.1.2",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/MichaelKuch/bitprint.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "serve": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "format": "prettier --write '**/*.{css,js,json,md,ts,tsx}'",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{css,js,json,md,ts,tsx}": "prettier --write"
  },
  "dependencies": {
    "@fontsource/ubuntu": "^5.3.0",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "classnames": "^2.5.1",
    "csvtojson": "^2.0.14",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0"
  }
}
